   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "26ce1c98",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"FEATURE ENGINEERING\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "df_fe = df.copy()\n",
    "\n",
    "# 1. Ratio-based features\n",
    "df_fe['RoomsPerHousehold'] = df_fe['AveRooms'] / (df_fe['HouseAge'] + 1e-6)\n",
    "df_fe['BedroomsRatio'] = df_fe['AveBedrms'] / (df_fe['AveRooms'] + 1e-6)\n",
    "df_fe['PopPerHousehold'] = df_fe['Population'] / (df_fe['AveOccup'] + 1e-6)\n",
    "\n",
    "# 2. Log transformations for skewed features\n",
    "df_fe['log_Population'] = np.log1p(df_fe['Population'])\n",
    "df_fe['log_Income'] = np.log1p(df_fe['MedInc'])\n",
    "\n",
    "# 3. Geographic features\n",
    "LA_LAT, LA_LONG = 34.05, -118.24\n",
    "SF_LAT, SF_LONG = 37.77, -122.42\n",
    "df_fe['Dist_LA'] = np.sqrt((df_fe['Latitude'] - LA_LAT)**2 + (df_fe['Longitude'] - LA_LONG)**2)\n",
    "df_fe['Dist_SF'] = np.sqrt((df_fe['Latitude'] - SF_LAT)**2 + (df_fe['Longitude'] - SF_LONG)**2)\n",
    "\n",
    "# 4. Interaction features\n",
    "df_fe['Income_x_Rooms'] = df_fe['MedInc'] * df_fe['AveRooms']\n",
    "df_fe['Income_x_Age'] = df_fe['MedInc'] * df_fe['HouseAge']\n",
    "\n",
    "print(f\"Original features: {df.shape[1]}\")\n",
    "print(f\"After feature engineering: {df_fe.shape[1]}\")\n",
    "print(f\"New features added: {df_fe.shape[1] - df.shape[1]}\")\n",
    "\n",
    "print(\"\\nNew feature correlations with target:\")\n",
    "new_features = ['RoomsPerHousehold', 'BedroomsRatio', 'PopPerHousehold', \n",
    "                'log_Population', 'log_Income', 'Dist_LA', 'Dist_SF',\n",
    "                'Income_x_Rooms', 'Income_x_Age']\n",
    "for feat in new_features:\n",
    "    corr = df_fe[feat].corr(df_fe['target'])\n",
    "    print(f\"  {feat:20s}: {corr:+.3f}\")\n",
    "\n",
    "display(df_fe.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Model Development"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "40d536e9",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"DATA SPLITTING\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "X = df_fe.drop(columns=['target'])\n",
    "y = df_fe['target']\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.2, random_state=SEED\n",
    ")\n",
    "\n",
    "print(f\"Training set: {X_train.shape[0]} samples ({X_train.shape[0]/len(X)*100:.1f}%)\")\n",
    "print(f\"Test set: {X_test.shape[0]} samples ({X_test.shape[0]/len(X)*100:.1f}%)\")\n",
    "print(f\"Features: {X_train.shape[1]}\")\n",
    "\n",
    "# Verify no data leakage\n",
    "train_indices = set(X_train.index)\n",
    "test_indices = set(X_test.index)\n",
    "overlap = train_indices.intersection(test_indices)\n",
    "print(f\"\\n✓ No data leakage: {len(overlap) == 0}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "bfd04a8d",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler, RobustScaler\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import LinearRegression, Ridge, Lasso, ElasticNet\n",
    "from sklearn.dummy import DummyRegressor\n",
    "from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\n",
    "from sklearn.ensemble import HistGradientBoostingRegressor\n",
    "from sklearn.neighbors import KNeighborsRegressor\n",
    "from sklearn.model_selection import KFold, cross_validate\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"MODEL COMPARISON (5-Fold Cross-Validation)\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Preprocessing pipeline\n",
    "preprocess = Pipeline(steps=[\n",
    "    ('imputer', SimpleImputer(strategy='median')),\n",
    "    ('scaler', RobustScaler()),\n",
    "])\n",
    "\n",
    "num_cols = X_train.columns.tolist()\n",
    "ct = ColumnTransformer([('num', preprocess, num_cols)], remainder='drop')\n",
    "\n",
    "# Define models\n",
    "models = {\n",
    "    'Dummy (Mean)': DummyRegressor(strategy='mean'),\n",
    "    'Linear Regression': LinearRegression(),\n",
    "    'Ridge (α=1.0)': Ridge(alpha=1.0, random_state=SEED),\n",
    "    'Lasso (α=0.01)': Lasso(alpha=0.01, random_state=SEED),\n",
    "    'KNN (k=5)': KNeighborsRegressor(n_neighbors=5),\n",
    "    'Random Forest': RandomForestRegressor(n_estimators=100, random_state=SEED, n_jobs=-1),\n",
    "    'HistGradientBoosting': HistGradientBoostingRegressor(random_state=SEED, max_iter=200),\n",
    "}\n",
    "\n",
    "# Cross-validation\n",
    "cv = KFold(n_splits=5, shuffle=True, random_state=SEED)\n",
    "scoring = {'rmse': 'neg_root_mean_squared_error', 'r2': 'r2', 'mae': 'neg_mean_absolute_error'}\n",
    "\n",
    "rows = []\n",
    "for name, model in models.items():\n",
    "    pipe = Pipeline([('prep', ct), ('model', model)])\n",
    "    res = cross_validate(pipe, X_train, y_train, cv=cv, scoring=scoring, n_jobs=-1, verbose=0)\n",
    "    rows.append({\n",
    "        'Model': name,\n",
    "        'RMSE Mean': -res['test_rmse'].mean(),\n",
    "        'RMSE Std': res['test_rmse'].std(),\n",
    "        'R² Mean': res['test_r2'].mean(),\n",
    "    })\n",
    "\n",
    "cv_df = pd.DataFrame(rows).sort_values('RMSE Mean')\n",
    "display(cv_df.style.background_gradient(subset=['R² Mean'], cmap='RdYlGn')\n",
    "                         .format({'RMSE Mean': '{:.4f}', 'RMSE Std': '{:.4f}', 'R² Mean': '{:.4f}'}))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize model comparison\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "colors = plt.cm.RdYlGn_r(np.linspace(0.2, 0.8, len(cv_df)))\n",
    "axes[0].barh(cv_df['Model'], cv_df['RMSE Mean'], xerr=cv_df['RMSE Std'], color=colors, capsize=3)\n",
    "axes[0].set_xlabel('RMSE (×$100,000)')\n",
    "axes[0].set_title('Model Comparison - RMSE (Lower is Better)')\n",
    "axes[0].invert_yaxis()\n",
    "\n",
    "axes[1].barh(cv_df['Model'], cv_df['R² Mean'], color=plt.cm.RdYlGn(np.linspace(0.2, 0.8, len(cv_df))))\n",
    "axes[1].set_xlabel('R² Score')\n",
    "axes[1].set_title('Model Comparison - R² (Higher is Better)')\n",
    "axes[1].invert_yaxis()\n",
    "axes[1].set_xlim(0, 1)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('model_comparison.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "best_model_name = cv_df.iloc[0]['Model']\n",
    "print(f\"\\n🏆 Best Model: {best_model_name}\")\n",
    "print(f\"   RMSE: {cv_df.iloc[0]['RMSE Mean']:.4f} (±{cv_df.iloc[0]['RMSE Std']:.4f})\")\n",
    "print(f\"   R²: {cv_df.iloc[0]['R² Mean']:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Hyperparameter Tuning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "93e24241",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import GridSearchCV, RandomizedSearchCV\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"HYPERPARAMETER TUNING\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Ridge Tuning\n",
    "print(\"\\n📊 Tuning Ridge Regression...\")\n",
    "ridge_pipe = Pipeline([('prep', ct), ('model', Ridge(random_state=SEED))])\n",
    "ridge_grid = {'model__alpha': np.logspace(-4, 4, 20)}\n",
    "ridge_gs = GridSearchCV(ridge_pipe, ridge_grid, cv=cv, scoring='neg_root_mean_squared_error', n_jobs=-1)\n",
    "ridge_gs.fit(X_train, y_train)\n",
    "print(f\"   Best RMSE: {-ridge_gs.best_score_:.4f}\")\n",
    "print(f\"   Best α: {ridge_gs.best_params_['model__alpha']:.6f}\")\n",
    "\n",
    "# HistGradientBoosting Tuning\n",
    "print(\"\\n🚀 Tuning HistGradientBoosting...\")\n",
    "hgb_pipe = Pipeline([('prep', ct), ('model', HistGradientBoostingRegressor(random_state=SEED))])\n",
    "hgb_space = {\n",
    "    'model__learning_rate': [0.01, 0.03, 0.05, 0.1],\n",
    "    'model__max_depth': [None, 3, 5, 7, 10],\n",
    "    'model__max_leaf_nodes': [15, 31, 63, 127],\n",
    "    'model__min_samples_leaf': [10, 20, 50],\n",
    "}\n",
    "hgb_rs = RandomizedSearchCV(hgb_pipe, hgb_space, n_iter=30, cv=cv, \n",
    "                           scoring='neg_root_mean_squared_error', n_jobs=-1, random_state=SEED)\n",
    "hgb_rs.fit(X_train, y_train)\n",
    "print(f\"   Best RMSE: {-hgb_rs.best_score_:.4f}\")\n",
    "print(f\"   Best params: {hgb_rs.best_params_}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Summary of tuned models\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"TUNED MODELS SUMMARY\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "tuned_results = pd.DataFrame([\n",
    "    {'Model': 'Ridge', 'RMSE': -ridge_gs.best_score_},\n",
    "    {'Model': 'HistGradientBoosting', 'RMSE': -hgb_rs.best_score_},\n",
    "]).sort_values('RMSE')\n",
    "\n",
    "display(tuned_results)\n",
    "\n",
    "best_tuned = tuned_results.iloc[0]\n",
    "print(f\"\\n🏆 Best Tuned Model: {best_tuned['Model']}\")\n",
    "\n",
    "# Select best model\n",
    "if best_tuned['Model'] == 'HistGradientBoosting':\n",
    "    final_model = hgb_rs.best_estimator_\n",
    "else:\n",
    "    final_model = ridge_gs.best_estimator_\n",
    "\n",
    "print(f\"   CV RMSE: {best_tuned['RMSE']:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Final Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "a8e2a3fa",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"FINAL EVALUATION ON TEST SET\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Train and predict\n",
    "final_model.fit(X_train, y_train)\n",
    "y_pred = final_model.predict(X_test)\n",
    "\n",
    "# Calculate metrics\n",
    "rmse = mean_squared_error(y_test, y_pred, squared=False)\n",
    "mae = mean_absolute_error(y_test, y_pred)\n",
    "r2 = r2_score(y_test, y_pred)\n",
    "\n",
    "print(f\"\\n📊 Test Set Metrics:\")\n",
    "print(f\"   RMSE: ${rmse*100000:,.0f}\")\n",
    "print(f\"   MAE:  ${mae*100000:,.0f}\")\n",
    "print(f\"   R²:   {r2:.4f}\")\n",
    "\n",
    "# Training set performance\n",
    "y_train_pred = final_model.predict(X_train)\n",
    "train_rmse = mean_squared_error(y_train, y_train_pred, squared=False)\n",
    "print(f\"\\n📊 Training RMSE: ${train_rmse*100000:,.0f}\")\n",
    "print(f\"💡 Generalization gap: RMSE diff = ${(train_rmse - rmse)*100000:,.0f}\")"
   ]
