     "print(f\"  Meilleur CV Score: {grid_search.best_score_*100:.2f}%\")\n",
     "\n",
     "best_model = grid_search.best_estimator_\n",
     "print(f\"\\nTest Accuracy (best): {accuracy_score(y_test, best_model.predict(X_test))*100:.2f}%\")\n"
