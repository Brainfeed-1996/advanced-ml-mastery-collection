  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PRÉTRAITEMENT\n",
      "=============\n",
      "Features: 4\n",
      "Train: 105 échantillons (70%)\n",
      "Test: 45 échantillons (30%)\n",
      "Normalisation: Non requise (Decision Tree)\n"
     ]
    }
   ],
   "source": [
    "# Préparation des données\n",
    "X = df[iris.feature_names]\n",
    "y = df['species']\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42, stratify=y)\n",
    "\n",
    "print(\"=\" * 60)\n",
    "PRÉTRAITEMENT\n",
    "=============\")\n",
    "print(f\"Features: {X.shape[1]}\")\n",
    "print(f\"Train: {len(X_train)} ({len(X_train)/len(X)*100:.0f}%)\")\n",
    "print(f\"Test: {len(X_test)} ({len(X_test)/len(X)*100:.0f}%)\")\n",
    "print(\"Normalisation: Non requise (Decision Tree)\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ARBRE DE DÉCISION - MODÈLE DE BASE\n",
      "==================================\n",
    "Hyperparamètres:\n",
    "  criterion: gini\n",
    "  max_depth: None (croissance complète)\n",
    "  min_samples_split: 2\n",
    "\n",
    "Performances:\n",
    "  Training Accuracy: 100.00%\n",
    "  Test Accuracy: 100.00%\n"
     ]
    }
   ],
   "source": [
    "# Modèle de base - Arbre de décision\n",
    "dt_model = DecisionTreeClassifier(random_state=42)\n",
    "dt_model.fit(X_train, y_train)\n",
    "\n",
    "print(\"=\" * 60)\n",
    "ARBRE DE DÉCISION - MODÈLE DE BASE\n",
    "===================================\")\n",
    "\n",
    "print(\"\\nHyperparamètres:\")\n",
    "print(f\"  criterion: {dt_model.criterion}\")\n",
    "print(f\"  max_depth: {dt_model.max_depth}\")\n",
    "print(f\"  min_samples_split: {dt_model.min_samples_split}\")\n",
    "\n",
    "y_train_pred = dt_model.predict(X_train)\n",
    "y_test_pred = dt_model.predict(X_test)\n",
    "\n",
    "print(\"\\nPerformances:\")\n",
    "print(f\"  Training Accuracy: {accuracy_score(y_train, y_train_pred)*100:.2f}%\")\n",
    "print(f\"  Test Accuracy: {accuracy_score(y_test, y_test_pred)*100:.2f}%\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
