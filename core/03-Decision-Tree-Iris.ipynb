   "source": [
    "# Visualisations exploratoires\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 12))\n",
    "fig.suptitle('Dataset Iris - Analyse Exploratoire', fontsize=16, fontweight='bold')\n",
    "\n",
    "colors = ['#2ecc71', '#3498db', '#e74c3c']\n",
    "species_names = ['setosa', 'versicolor', 'virginica']\n",
    "\n",
    "# 1. Pairplot simplifié - Petal\n",
    "ax1 = axes[0, 0]\n",
    "for i, species in enumerate(species_names):\n",
    "    mask = df['species_name'] == species\n",
    "    ax1.scatter(df[mask]['petal length (cm)'], df[mask]['petal width (cm)'],\n",
    "               c=colors[i], label=species.capitalize(), alpha=0.7, s=60)\n",
    "ax1.set_xlabel('Longueur du pétale (cm)')\n",
    "ax1.set_ylabel('Largeur du pétale (cm)')\n",
    "ax1.set_title('Pétale: Longueur vs Largeur')\n",
    "ax1.legend()\n",
    "\n",
    "# 2. Pairplot simplifié - Sépale\n",
    "ax2 = axes[0, 1]\n",
    "for i, species in enumerate(species_names):\n",
    "    mask = df['species_name'] == species\n",
    "    ax2.scatter(df[mask]['sepal length (cm)'], df[mask]['sepal width (cm)'],\n",
    "               c=colors[i], label=species.capitalize(), alpha=0.7, s=60)\n",
    "ax2.set_xlabel('Longueur du sépale (cm)')\n",
    "ax2.set_ylabel('Largeur du sépale (cm)')\n",
    "ax2.set_title('Sépale: Longueur vs Largeur')\n",
    "ax2.legend()\n",
    "\n",
    "# 3. Distribution de la longueur du pétale\n",
    "ax3 = axes[1, 0]\n",
