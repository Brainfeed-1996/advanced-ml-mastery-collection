    "    mask = df['species_name'] == species\n",
    "    ax3.hist(df[mask]['petal length (cm)'], bins=15, alpha=0.6, \n",
    "            label=species.capitalize(), color=colors[i])\n",
    "ax3.set_xlabel('Longueur du pétale (cm)')\n",
    "ax3.set_ylabel('Fréquence')\n",
    "ax3.set_title('Distribution Longueur Pétale')\n",
    "ax3.legend()\n",
    "\n",
    "# 4. Matrice de corrélation\n",
    "ax4 = axes[1, 1]\n",
    "corr = df[iris.feature_names].corr()\n",
    "sns.heatmap(corr, annot=True, cmap='RdBu_r', center=0, fmt='.2f', ax=ax4)\n",
    "ax4.set_title('Matrice de Corrélation')\n",
    "\n",
    "plt.tight_layout()\n",
