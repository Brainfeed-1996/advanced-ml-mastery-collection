      "mean         5.84        3.06        3.76        1.20\n",
      "std          0.83        0.43        1.76        0.76\n",
      "min          4.3         2.0          1.0          0.1\n",
      "max          7.9         4.4          6.9          2.5\n"
     ]
    }
   ],
   "source": [
    "print(\"\\nSTATISTIQUES DESCRIPTIVES\")\n",
    "print(\"=\" * 60)\n",
    "print(df[iris.feature_names].describe().round(2))\n",
