   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "stream": "stdout",
     "text": [
      "DATASET: Coeur Artificiel (30000 échantillons)\n",
      "Shape: (30000, 11)\n",
      "Variables:\n",
      "1. Age\n",
      "2. Sex\n",
      "3. ChestPainType\n",
      "4. RestingBP\n",
      "5. Cholesterol\n",
    "6. FastingBS\n",
      "7. RestingECG\n",
      "8. MaxHR\n",
      "9. ExerciseAngina\n",
      "10. Oldpeak\n",
      "11. HeartDisease\n"
     ]
    }
   ],
   "source": [
    "# Génération d'un dataset médical réaliste\n",
    "np.random.seed(42)\n",
    "n_samples = 30000\n",
    "\n",
    "# Création de données synthétiques réalistes\n",
    "age = np.random.normal(55, 10, n_samples).clip(30, 80)\n",
    "sex = np.random.choice([0, 1], n_samples, p=[0.4, 0.6])\n",
    "chest_pain = np.random.choice([0, 1, 2, 3], n_samples, p=[0.3, 0.3, 0.25, 0.15])\n",
    "resting_bp = np.random.normal(130, 20, n_samples).clip(80, 200)\n",
    "cholesterol = np.random.normal(200, 50, n_samples).clip(100, 400)\n",
    "fasting_bs = np.random.choice([0, 1], n_samples, p=[0.85, 0.15])\n",
    "resting_ecg = np.random.choice([0, 1, 2], n_samples, p=[0.6, 0.3, 0.1])\n",
    "max_hr = np.random.normal(140, 25, n_samples).clip(60, 200)\n",
    "exercise_angina = np.random.choice([0, 1], n_samples, p=[0.65, 0.35])\n",
    "oldpeak = np.random.exponential(1, n_samples).clip(0, 6)\n",
    "\n",
    "# Variable cible: HeartDisease (influencée par les facteurs de risque)\n",
    "heart_disease = (\n",
    "    0.02 * (age - 55) + \n",
    "    0.05 * sex + \n",
    "    0.08 * chest_pain + \n",
    "    0.01 * (resting_bp - 130) + \n",
    "    0.005 * (cholesterol - 200) + \n",
    "    0.2 * fasting_bs - \n",
    "    0.01 * (max_hr - 140) + \n",
    "    0.15 * exercise_angina + \n",
    "    0.2 * oldpeak +\n",
    "    np.random.normal(0, 0.3, n_samples)\n",
    ") > 0\n",
    "heart_disease = heart_disease.astype(int)\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'Age': age,\n",
    "    'Sex': sex,\n",
    "    'ChestPainType': chest_pain,\n",
    "    'RestingBP': resting_bp,\n",
    "    'Cholesterol': cholesterol,\n",
    "    'FastingBS': fasting_bs,\n",
    "    'RestingECG': resting_ecg,\n",
    "    'MaxHR': max_hr,\n",
    "    'ExerciseAngina': exercise_angina,\n",
    "    'Oldpeak': oldpeak,\n",
    "    'HeartDisease': heart_disease\n",
    "})\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"DATASET: Coeur Artificiel\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"Shape: {df.shape}\")\n",
    "print(f\"\\nVariables:\")\n",
    "for i, col in enumerate(df.columns, 1):\n",
    "    print(f\"{i:2d}. {col}\")\n"
   ]
  },
